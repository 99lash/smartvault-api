# JWT Configuration
JWT_SECRET=your-super-secure-secret-key-change-this-in-production
DATABASE_URL=sqlite:///./smartvault.db
REDIS_URL=redis://localhost:6379
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Example (use stronger settings):
# JWT_SECRET=your-production-secret-key-with-at-least-32-characters
# JWT_ALGORITHM=HS512
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
